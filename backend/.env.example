# Database configuration (PostgreSQL / Supabase connection URL)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# For Supabase connection pooler: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_DB=postgresql://postgres:your_password@localhost:5432/postgres

# JWT Secret for token generation and validation
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Email configuration for OTP registration & verification (FastAPI-Mail)
# If using Gmail, generate an App Password from your Google Account security settings
MAIL_SERVER=smtp.gmail.com
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
